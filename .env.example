# ===== ตัวอย่างไฟล์ environment (คัดลอกเป็น .env.local สำหรับพัฒนา) =====

# ที่อยู่เว็บหลัก (ใช้ในลิงก์อีเมลแจ้งเตือน)
APP_URL=http://localhost:3000

# ===== ไฟล์เอกสาร =====
# โหมดไฟล์: auto (ใช้ Google Drive ถ้าตั้งค่า GAS) | drive | local
STORAGE_BACKEND=auto
# URL ของ Google Apps Script (/exec) — เมื่อตั้งค่าแล้วจะอัปโหลดขึ้น Google Drive
GAS_WEBAPP_URL=
# รหัสลับเดียวกับ Script property GAS_SECRET ใน Apps Script
GAS_SECRET=
# โฟลเดอร์ Google Drive สำหรับเก็บไฟล์
GDRIVE_FOLDER_ID=1AtnkpeRcZ7KVD2wpgwIi2hNsq8Mt-E2Q

# ===== การส่งอีเมลแจ้งเตือน =====
# log | gas | resend | webhook
EMAIL_PROVIDER=log
# ใช้เมื่อ EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=Document System <onboarding@resend.dev>
# ใช้เมื่อ EMAIL_PROVIDER=webhook
EMAIL_WEBHOOK_URL=

# ===== การแจ้งเตือนอัตโนมัติ (cron) =====
CRON_SECRET=

# ===== ฐานข้อมูล (โหมด Node เท่านั้น) =====
SQLITE_PATH=./data/document.db
UPLOAD_DIR=./data/uploads
